          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, application) (rate(http_server_requests_seconds_bucket{application=~\"$application\", app_type=~\"$app_type\"}[5m])))",
          "legendFormat": "{{application}} p95",
          "refId": "A"
        }
      ],
      "title": "RED Duration P95",
      "type": "timeseries"
