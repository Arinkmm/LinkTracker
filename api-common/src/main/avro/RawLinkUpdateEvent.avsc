{
  "type": "record",
  "name": "RawLinkUpdateEvent",
  "namespace": "backend.academy.linktracker.avro",
  "fields": [
    {
      "name": "id",
      "type": "long",
      "doc": "Tracked link id"
    },
    {
      "name": "url",
      "type": "string",
      "doc": "Tracked link URL"
    },
    {
      "name": "description",
      "type": "string",
      "doc": "Update body text"
    },
    {
      "name": "author",
      "type": "string",
      "default": "unknown",
      "doc": "Update author"
    },
    {
      "name": "tgChatIds",
      "type": {
        "type": "array",
        "items": "long"
      },
      "doc": "Telegram chat ids"
    }
  ]
}
